# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Project Settings -> API. Both of these are safe to expose to the browser;
# Row Level Security is what protects the data, not secrecy of the anon key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional. Server-side only, never exposed to the browser. Not required to run
# the site — only used by the admin panel for operations that must bypass RLS
# (currently: none). Leave unset unless you know you need it.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Absolute origin, used for canonical URLs, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Local development without Supabase
# ---------------------------------------------------------------------------
# If NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY are unset, the
# site falls back to the bundled sample dataset in src/lib/data/fixtures.ts,
# which mirrors supabase/seed.sql exactly. `npm run dev` works with no
# configuration at all. The admin panel requires real Supabase credentials.
